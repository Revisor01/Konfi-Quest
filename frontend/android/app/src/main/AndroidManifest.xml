<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false: Die App haelt Login-Token und Chat-Inhalte von
         Jugendlichen vor. Mit Androids Auto-Backup landeten die im Google-Konto
         der Nutzer:innen und liessen sich auf ein anderes Geraet einspielen. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Hochformat, und zwar ueberall (Simon, 19.09.2026: "Will ich nicht
             auf phones"). Die App ist fuer eine Hand gebaut.

             WARUM NICHT NACH GERAETEGROESSE GETRENNT: Der Versuch, hier eine
             Ressource aus values/ und values-sw600dp/ zu lesen, scheitert an
             Android selbst. Lint sagt: "Resources referenced from the manifest
             cannot vary by configuration [...] This value will not be used."
             Das Manifest wird beim Installieren aufgeloest, nicht zur
             Laufzeit; die Tablet-Fassung waere nie gezogen worden, und wir
             haetten etwas ausgeliefert, das nur so aussieht, als taete es was.

             Ab Android 16 ignorieren grosse Displays die Sperre ohnehin,
             genau darauf weist die Play Console hin. Auf Telefonen bleibt sie
             wirksam, und das ist der Zweck. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (24.09.2026): Links auf konfi-quest.de oeffnen die
                 App statt des Browsers. Android prueft dafuer beim Installieren
                 https://konfi-quest.de/.well-known/assetlinks.json (liegt in
                 frontend/public/.well-known) gegen den Signaturschluessel;
                 nur mit autoVerify entfaellt die Nachfrage "Oeffnen mit".

                 NUR https und NUR die Pfade, die die App auch hat: Die
                 Einladung (/register?code=...) aus QR-Code und Elternbrief,
                 der Link aus der Passwort-vergessen-Mail (/reset-password)
                 und /login von der Werbeseite. Werbeseite, Datenschutz,
                 Impressum, Handbuch und API-Doku bleiben im Browser, denn die
                 App hat dafuer keine Seite und wuerde nur ins Leere springen.

                 KEIN www.konfi-quest.de: Der Server leitet www per 301 auf
                 konfi-quest.de um, auch fuer die assetlinks.json. Android
                 verlangt fuer die Pruefung aber 200 ohne Umleitung; ein
                 unpruefbarer Host liesse vor Android 12 die Pruefung ALLER
                 Hosts scheitern. Und kein Code der App erzeugt www-Links.

                 Die Pfadliste spiegelt utils/deepLinks.ts; der Test in
                 __tests__/navigation/appLinksAndroid.test.ts haelt beide
                 in Deckung. Wer hier einen Pfad ergaenzt, ergaenzt ihn dort. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="konfi-quest.de" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/register" />
                <data android:pathPrefix="/reset-password" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Benachrichtigungen ab Android 13 (API 33). Ohne diese Deklaration darf
         die App dort KEINE Push-Nachrichten anzeigen — PushNotifications
         .requestPermissions() im AppContext laeuft dann ins Leere, ohne dass ein
         Dialog erscheint. Das Capacitor-Push-Plugin bringt nur den
         Messaging-Service mit, nicht diese Berechtigung. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometrische Anmeldung (Fingerabdruck / Gesichtsentsperrung). Ohne
         diese Deklaration meldet BiometricManager keine Verfuegbarkeit und der
         Schalter im Profil erscheint auf keinem Geraet. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Biometrie ist kein Muss: Geraete ohne Sensor sollen die App weiterhin
         installieren koennen, sie sehen den Schalter dann einfach nicht. -->
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />

    <!-- Kamera fuer den QR-Scanner (Event-Checkin). Ohne diese Deklaration
         verweigert Android getUserMedia in der WebView, ohne dass der Nutzer
         ueberhaupt einen Berechtigungsdialog zu sehen bekommt. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Die Kamera ist kein Muss: Geraete ohne Kamera sollen die App weiterhin
         aus dem Play Store installieren koennen. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
