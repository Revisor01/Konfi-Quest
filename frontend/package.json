    "live:android": "cap run android --live-reload --host $(ipconfig getifaddr en0 || ipconfig getifaddr en1) --port 5173",
    "build": "tsc && vite build",
    "docs:api": "node ../scripts/build-api-docs.mjs",
    "docs:handbuch": "node ../scripts/build-handbuch.mjs",
    "docs:openapi": "node ../scripts/build-openapi.mjs",
    "dunkelmodus:bilder": "node scripts/dunkelmodus-bilder.mjs",
    "dunkelmodus:messen": "node scripts/dunkelmodus-messen.mjs",
    "preview": "vite preview",
    "test.unit": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-firebase/crashlytics": "^8.5.2",
