    "@capawesome/capacitor-background-task": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.8.1",
    "@ionic/core": "^9.0.7",
    "@ionic/react": "^9.0.7",
    "@ionic/react-router": "^9.0.7",
